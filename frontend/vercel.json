{
    "rewrites": [
        {
            "source": "/",
            "destination": "/HomePage/source/TrangChu.html"
        },
        {
            "source": "/frontend/(.*)",
            "destination": "/$1"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                },
                {
                    "key": "Access-Control-Allow-Methods",
                    "value": "GET, POST, PUT, DELETE, OPTIONS"
                }
            ]
        }
    ]
}